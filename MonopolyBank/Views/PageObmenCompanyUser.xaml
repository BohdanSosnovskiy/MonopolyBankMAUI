<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MonopolyBank.Models"
             xmlns:controls="clr-namespace:MonopolyBank.Controls"
             x:Class="MonopolyBank.Views.PageObmenCompanyUser"
             BackgroundColor="#fbfbfd"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="10, 15, 10, 30">

            <!-- 1. Cancel Trade Button -->
            <Button Text="Отменить сделку"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="14"
                    HeightRequest="46"
                    HorizontalOptions="Fill"
                    Clicked="OnCancelClicked">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#fd6244" Offset="0.1" />
                        <GradientStop Color="#e73d60" Offset="1.0" />
                    </LinearGradientBrush>
                </Button.Background>
                <Button.Shadow>
                    <Shadow Brush="Black" Offset="2,5" Radius="10" Opacity="0.25"/>
                </Button.Shadow>
            </Button>

            <!-- 2. Dual Status and Ready Panel (Beige background with Cyan and Coral blocks) -->
            <Border StrokeShape="{RoundRectangle CornerRadius=14}"
                    StrokeThickness="0"
                    BackgroundColor="#F5F5DC"
                    Margin="0, 16, 0, 0"
                    Padding="0">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="2,6" Radius="12" Opacity="0.18"/>
                </Border.Shadow>
                <Grid RowDefinitions="Auto,Auto">
                    <!-- Top dual user info -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,*">
                        <!-- Left: Current User (Cyan) -->
                        <Border Grid.Column="0"
                                HeightRequest="75"
                                StrokeShape="{RoundRectangle CornerRadius='14,0,14,0'}"
                                StrokeThickness="0"
                                Padding="12,8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#019dce" Offset="0.1" />
                                    <GradientStop Color="#0daaa3" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <Label Grid.Row="0" Grid.Column="0"
                                       x:Name="MyNameLabel"
                                       Text="Я"
                                       TextColor="White"
                                       FontSize="15"
                                       FontAttributes="Bold" />
                                <Label Grid.Row="0" Grid.Column="1"
                                       x:Name="MyReadyLabel"
                                       Text="Не готов"
                                       TextColor="White"
                                       FontSize="14" />
                                <Label Grid.Row="1" Grid.ColumnSpan="2"
                                       x:Name="MySumLabel"
                                       Text="Сумма сделки: 0 $"
                                       TextColor="White"
                                       FontSize="14"
                                       Margin="0,6,0,0" />
                            </Grid>
                        </Border>

                        <!-- Right: Target User (Coral) -->
                        <Border Grid.Column="1"
                                HeightRequest="75"
                                StrokeShape="{RoundRectangle CornerRadius='0,14,0,14'}"
                                StrokeThickness="0"
                                Padding="12,8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#fd6244" Offset="0.1" />
                                    <GradientStop Color="#e73d60" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                <Label Grid.Row="0" Grid.Column="0"
                                       x:Name="TargetReadyLabel"
                                       Text="Не готов"
                                       TextColor="White"
                                       FontSize="14" />
                                <Label Grid.Row="0" Grid.Column="1"
                                       x:Name="TargetNameLabel"
                                       Text="Игрок"
                                       TextColor="White"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       HorizontalOptions="End" />
                                <Label Grid.Row="1" Grid.ColumnSpan="2"
                                       x:Name="TargetSumLabel"
                                       Text="Сумма сделки: 0 $"
                                       TextColor="White"
                                       FontSize="14"
                                       HorizontalOptions="End"
                                       Margin="0,6,0,0" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Center "Заключить сделку" Button -->
                    <Button Grid.Row="1"
                            x:Name="BtnConfirmTrade"
                            Text="Заключить сделку"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="16"
                            CornerRadius="10"
                            HeightRequest="42"
                            Margin="12, 10, 12, 12"
                            HorizontalOptions="Fill"
                            Clicked="OnConfirmTradeClicked">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#55b155" Offset="0.1" />
                                <GradientStop Color="#3b7d3b" Offset="1.0" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </Grid>
            </Border>

            <!-- 3. Section "Ваше предложение" (Cyan container) -->
            <Border StrokeShape="{RoundRectangle CornerRadius=16}"
                    StrokeThickness="0"
                    Margin="0, 18, 0, 0"
                    Padding="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#019dce" Offset="0.1" />
                        <GradientStop Color="#0daaa3" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="3,6" Radius="12" Opacity="0.25"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="8" Padding="0, 12, 0, 14">
                    <Label Text="Ваше предложение"
                           TextColor="White"
                           FontSize="22"
                           FontAttributes="Bold"
                           Margin="16, 0, 0, 0" />

                    <!-- My Companies Horizontal List -->
                    <CollectionView x:Name="MyCompaniesList"
                                    HeightRequest="290">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.EmptyView>
                            <Label Text="Нет предприятий для обмена"
                                   TextColor="White"
                                   FontSize="14"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Margin="0, 80, 0, 80" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Company">
                                <Grid Padding="12, 4, 4, 8">
                                    <controls:CompanyCardView BindingContext="{Binding .}" />
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnMyCompanySelected" CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Cash Entry matching screenshot 1 -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="16, 4, 16, 0">
                        <Label Text="Сумма"
                               TextColor="White"
                               FontSize="22"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                        <Border Grid.Column="1"
                                StrokeShape="{RoundRectangle CornerRadius=10}"
                                StrokeThickness="0"
                                BackgroundColor="#cfd9e5"
                                HeightRequest="46"
                                Padding="12, 0">
                            <Entry x:Name="MyMoneyEntry"
                                   Keyboard="Numeric"
                                   Text="0"
                                   TextColor="#1A1A1A"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextChanged="OnMoneyChanged"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- 4. Center Gold Coin Exchange Icon (torg_money.png) -->
            <Image Source="torg_money.png"
                   HeightRequest="56"
                   WidthRequest="56"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   Margin="0, 14, 0, 14" />

            <!-- 5. Section "Активы игрока {Name}" (Coral container) -->
            <Border StrokeShape="{RoundRectangle CornerRadius=16}"
                    StrokeThickness="0"
                    Margin="0, 0, 0, 15"
                    Padding="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#fd6244" Offset="0.1" />
                        <GradientStop Color="#e73d60" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="3,6" Radius="12" Opacity="0.25"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="8" Padding="0, 12, 0, 14">
                    <Label x:Name="TargetSectionTitle"
                           Text="Активы игрока"
                           TextColor="White"
                           FontSize="22"
                           FontAttributes="Bold"
                           Margin="16, 0, 0, 0" />

                    <!-- Target Companies Horizontal List -->
                    <CollectionView x:Name="TargetCompaniesList"
                                    HeightRequest="290">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.EmptyView>
                            <Label Text="У игрока нет предприятий для обмена"
                                   TextColor="White"
                                   FontSize="14"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Margin="0, 80, 0, 80" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Company">
                                <Grid Padding="12, 4, 4, 8">
                                    <controls:CompanyCardView BindingContext="{Binding .}" />
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTargetCompanySelected" CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Cash Entry matching screenshot 1 -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="16, 4, 16, 0">
                        <Label Text="Сумма"
                               TextColor="White"
                               FontSize="22"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                        <Border Grid.Column="1"
                                StrokeShape="{RoundRectangle CornerRadius=10}"
                                StrokeThickness="0"
                                BackgroundColor="#cfd9e5"
                                HeightRequest="46"
                                Padding="12, 0">
                            <Entry x:Name="TargetMoneyEntry"
                                   Keyboard="Numeric"
                                   Text="0"
                                   TextColor="#1A1A1A"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextChanged="OnMoneyChanged"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
