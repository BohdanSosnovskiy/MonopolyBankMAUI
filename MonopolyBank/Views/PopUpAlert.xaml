<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonopolyBank.Views.PopUpAlert"
             BackgroundColor="Transparent"
             Title="PopUpAlert">

    <Grid>
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnBackdropTapped" />
        </Grid.GestureRecognizers>

        <Border VerticalOptions="Center"
                HorizontalOptions="Fill"
                Margin="24"
                BackgroundColor="White"
                StrokeShape="{RoundRectangle CornerRadius=20}"
                Padding="0"
                StrokeThickness="0">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,8" Radius="20" Opacity="0.4"/>
            </Border.Shadow>

            <Grid RowDefinitions="44,Auto,Auto" Padding="0,0,0,20">
                <!-- Header with dark blue gradient matching existing popups -->
                <Border Grid.Row="0"
                        HeightRequest="44"
                        StrokeShape="{RoundRectangle CornerRadius='20,20,0,0'}"
                        StrokeThickness="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#27283d" Offset="0.1" />
                            <GradientStop Color="#575a89" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Label x:Name="TitleLabel"
                           Text="Внимание"
                           FontSize="18"
                           TextColor="White"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"/>
                </Border>

                <!-- Message text -->
                <Label Grid.Row="1"
                       x:Name="DescLabel"
                       FontSize="16"
                       TextColor="#333333"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Margin="22, 24, 22, 22"
                       LineHeight="1.2" />

                <!-- Single Button (Alert mode) -->
                <Button Grid.Row="2"
                        x:Name="ConfirmBtn"
                        Text="OK"
                        Clicked="OnConfirmClicked"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="16"
                        CornerRadius="12"
                        HeightRequest="44"
                        Margin="22, 0, 22, 0"
                        HorizontalOptions="Fill">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#fd6244" Offset="0.0" />
                            <GradientStop Color="#e73d60" Offset="1.0" />
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Shadow>
                        <Shadow Brush="Black" Offset="0,3" Radius="6" Opacity="0.25"/>
                    </Button.Shadow>
                </Button>

                <!-- Dual Buttons (Confirmation mode) -->
                <Grid Grid.Row="2"
                      x:Name="ConfirmGrid"
                      ColumnDefinitions="*,*"
                      ColumnSpacing="14"
                      Margin="22, 0, 22, 0"
                      IsVisible="False">
                    <Button Grid.Column="0"
                            x:Name="CancelDualBtn"
                            Text="Отклонить"
                            Clicked="OnCancelDualClicked"
                            TextColor="#555555"
                            FontAttributes="Bold"
                            FontSize="15"
                            BackgroundColor="#e8ecef"
                            CornerRadius="12"
                            HeightRequest="44"/>

                    <Button Grid.Column="1"
                            x:Name="AcceptDualBtn"
                            Text="Да"
                            Clicked="OnAcceptDualClicked"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="15"
                            CornerRadius="12"
                            HeightRequest="44">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#fd6244" Offset="0.0" />
                                <GradientStop Color="#e73d60" Offset="1.0" />
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Shadow>
                            <Shadow Brush="Black" Offset="0,3" Radius="6" Opacity="0.25"/>
                        </Button.Shadow>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>

</ContentPage>
