<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MonopolyBank.Models"
             xmlns:controls="clr-namespace:MonopolyBank.Controls"
             x:Class="MonopolyBank.Views.PopUpInfoUser"
             BackgroundColor="#80000000">

    <Grid>
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnBackdropTapped" />
        </Grid.GestureRecognizers>

        <Border VerticalOptions="Center"
                HorizontalOptions="Center"
                WidthRequest="330"
                BackgroundColor="White"
                StrokeShape="{RoundRectangle CornerRadius=20}"
                Padding="16"
                StrokeThickness="0">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="4,10" Radius="25" Opacity="0.4"/>
            </Border.Shadow>

            <ScrollView MaximumHeightRequest="560">
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">

                    <!-- Glossy Bank Card for Player -->
                    <Border HeightRequest="160"
                            WidthRequest="290"
                            StrokeShape="{RoundRectangle CornerRadius=18}"
                            StrokeThickness="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#fd6244" Offset="0.1" />
                                <GradientStop Color="#e73d60" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="2,6" Radius="15" Opacity="0.3"/>
                        </Border.Shadow>
                        <Grid>
                            <!-- Name Badge -->
                            <Border HorizontalOptions="Start"
                                    VerticalOptions="Start"
                                    HeightRequest="32"
                                    StrokeShape="{RoundRectangle CornerRadius='0,0,0,10'}"
                                    StrokeThickness="0"
                                    Padding="10,0,14,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#151618" Offset="0.1" />
                                        <GradientStop Color="#44474b" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Label Text="{Binding Name}"
                                       TextColor="White"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                            </Border>

                            <Image Source="bank_monopoly_logo.png"
                                   WidthRequest="130"
                                   HeightRequest="50"
                                   Opacity="0.75"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Start"
                                   Margin="0,10,0,0" />

                            <Image Source="mastercard_logo.png"
                                   HeightRequest="30"
                                   WidthRequest="45"
                                   Aspect="AspectFit"
                                   HorizontalOptions="End"
                                   VerticalOptions="End"
                                   Margin="0,0,15,12" />

                            <VerticalStackLayout HorizontalOptions="Start"
                                                 VerticalOptions="End"
                                                 Margin="16,0,0,12"
                                                 Spacing="1">
                                <Label Text="Сумма на баллансе"
                                       TextColor="White"
                                       FontSize="13"
                                       Opacity="0.9" />
                                <Label Text="{Binding Cash, StringFormat='{0} $'}"
                                       TextColor="White"
                                       FontSize="24"
                                       FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Section Title -->
                    <Label Text="Активы игрока:"
                           TextColor="#333333"
                           FontSize="15"
                           FontAttributes="Bold"
                           Margin="4,4,0,0"
                           HorizontalOptions="Start" />

                    <!-- Horizontal Carousel of Player's Real Cards -->
                    <Grid HeightRequest="285" WidthRequest="290">
                        <CollectionView x:Name="PlayerCompaniesList"
                                        ItemsSource="{Binding Companys}"
                                        HeightRequest="280">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.EmptyView>
                                <Label Text="У игрока пока нет фирм"
                                       TextColor="#888888"
                                       FontSize="13"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Company">
                                    <Grid Padding="0,0,4,6">
                                        <controls:CompanyCardView BindingContext="{Binding .}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>

                    <!-- Action Button: Начислить зарплату за круг (только для Хоста) -->
                    <Button x:Name="BtnPaySalary"
                            Text="💰 Начислить зарплату за круг"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="14"
                            CornerRadius="14"
                            HeightRequest="44"
                            WidthRequest="280"
                            Margin="0,4,0,0"
                            IsVisible="False"
                            Clicked="OnPaySalaryClicked">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#55b155" Offset="0.1" />
                                <GradientStop Color="#2e7d32" Offset="1.0" />
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Shadow>
                            <Shadow Brush="Black" Offset="2,4" Radius="8" Opacity="0.3"/>
                        </Button.Shadow>
                    </Button>

                    <!-- Action Button: Предложить сделку -->
                    <Button x:Name="BtnStartTrade"
                            Text="Предложить сделку"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="15"
                            CornerRadius="14"
                            HeightRequest="44"
                            WidthRequest="280"
                            Margin="0,6,0,4"
                            Clicked="OnStartTradeClicked">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#019dce" Offset="0.1" />
                                <GradientStop Color="#0daaa3" Offset="1.0" />
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Shadow>
                            <Shadow Brush="Black" Offset="2,4" Radius="8" Opacity="0.3"/>
                        </Button.Shadow>
                    </Button>
                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>

</ContentPage>
