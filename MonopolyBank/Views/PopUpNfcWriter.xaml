<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonopolyBank.Views.PopUpNfcWriter"
             BackgroundColor="#80000000">

    <Grid>
        <Border VerticalOptions="Center"
                HorizontalOptions="Center"
                WidthRequest="310"
                BackgroundColor="#161822"
                StrokeShape="{RoundRectangle CornerRadius=22}"
                Padding="20"
                StrokeThickness="0">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="4,10" Radius="25" Opacity="0.5"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                <Image Source="nfc_logo.png"
                       HeightRequest="70"
                       WidthRequest="100"
                       Aspect="AspectFit"
                       HorizontalOptions="Center" />

                <Label Text="ПРИВЯЗКА NFC"
                       TextColor="White"
                       FontSize="18"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />

                <Label x:Name="CardNameLabel"
                       Text="Карточка: ..."
                       TextColor="#0daaa3"
                       FontSize="14"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />

                <Label x:Name="StatusLabel"
                       Text="Поднесите NFC-метку или карточку к задней крышке телефона..."
                       TextColor="#bbb"
                       FontSize="12"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center" />

                <!-- Activity / Success indicator -->
                <ActivityIndicator x:Name="ProgressIndicator"
                                   IsRunning="True"
                                   Color="#0daaa3"
                                   HeightRequest="36" />

                <Button Text="Отмена"
                        TextColor="#999"
                        BackgroundColor="#27283d"
                        FontSize="13"
                        FontAttributes="Bold"
                        HeightRequest="40"
                        CornerRadius="12"
                        Clicked="OnCancelClicked" />
            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentPage>
