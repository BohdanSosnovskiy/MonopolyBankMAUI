<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MonopolyBank.Models"
             x:Class="MonopolyBank.Views.PagePresetEditor"
             BackgroundColor="#0e1017"
             Title="Редактор Монополии">

    <Grid RowDefinitions="Auto,*,Auto" Padding="14,10">
        <!-- Header: Name Input and Save Button -->
        <Border Grid.Row="0"
                BackgroundColor="#161824"
                StrokeShape="{RoundRectangle CornerRadius=14}"
                StrokeThickness="1"
                Padding="12,8"
                Margin="0,0,0,10">
            <Border.Stroke>
                <SolidColorBrush Color="#282a3a" />
            </Border.Stroke>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                    <Label Text="НАЗВАНИЕ МОНОПОЛИИ:" TextColor="#888" FontSize="10" FontAttributes="Bold" />
                    <Entry x:Name="PresetNameEntry"
                           Placeholder="Моя Монополия"
                           TextColor="White"
                           FontSize="16"
                           FontAttributes="Bold"
                           BackgroundColor="Transparent"
                           Margin="0" />
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="💾 Сохранить"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="13"
                        BackgroundColor="#0daaa3"
                        CornerRadius="10"
                        HeightRequest="42"
                        Padding="14,0"
                        VerticalOptions="Center"
                        Clicked="OnSaveClicked" />
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <CollectionView x:Name="CompaniesCollection"
                            SelectionMode="None">
                <CollectionView.Header>
                    <!-- Settings Banner -->
                    <Border BackgroundColor="#181a24"
                            StrokeShape="{RoundRectangle CornerRadius=14}"
                            StrokeThickness="1"
                            Padding="12,10"
                            Margin="0,0,0,10">
                        <Border.Stroke>
                            <SolidColorBrush Color="#2c2e3d" />
                        </Border.Stroke>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Старт капитал" TextColor="#888" FontSize="10" />
                                <Entry x:Name="StartCashEntry" Keyboard="Numeric" TextColor="White" FontSize="13" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Проход Старт" TextColor="#888" FontSize="10" />
                                <Entry x:Name="PassGoEntry" Keyboard="Numeric" TextColor="White" FontSize="13" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="2">
                                <Label Text="Выкуп Тюрьма" TextColor="#888" FontSize="10" />
                                <Entry x:Name="JailFeeEntry" Keyboard="Numeric" TextColor="White" FontSize="13" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Company">
                        <Border Margin="0,4"
                                BackgroundColor="#1a1c26"
                                StrokeShape="{RoundRectangle CornerRadius=14}"
                                StrokeThickness="1"
                                Padding="12,10">
                            <Border.Stroke>
                                <SolidColorBrush Color="#282a38" />
                            </Border.Stroke>

                            <Grid ColumnDefinitions="14,*,Auto" ColumnSpacing="10">
                                <!-- Color Strip -->
                                <Border Grid.Column="0"
                                        BackgroundColor="{Binding color}"
                                        StrokeShape="{RoundRectangle CornerRadius=6}"
                                        StrokeThickness="0"
                                        WidthRequest="12"
                                        HorizontalOptions="Center" />

                                <!-- Details -->
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Name}"
                                           TextColor="White"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation" />
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding Price, StringFormat='Цена: {0} $'}"
                                               TextColor="#0daaa3"
                                               FontSize="12"
                                               FontAttributes="Bold" />
                                        <Label Text="{Binding nfc_marker, StringFormat='NFC: [{0}]'}"
                                               TextColor="#777"
                                               FontSize="11" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <!-- Edit & NFC Buttons -->
                                <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                    <Button Text="📱 NFC"
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            TextColor="White"
                                            BackgroundColor="#27283d"
                                            CornerRadius="8"
                                            HeightRequest="34"
                                            Clicked="OnWriteNfcClicked"
                                            CommandParameter="{Binding .}" />

                                    <Button Text="Редакт."
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            TextColor="White"
                                            BackgroundColor="#0daaa3"
                                            CornerRadius="8"
                                            HeightRequest="34"
                                            Clicked="OnEditCompanyClicked"
                                            CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Bottom Action Bar: Добавить улицу & Пакетная NFC прошивка -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
            <Button Grid.Column="0"
                    Text="+ Добавить улицу"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="13"
                    HeightRequest="44"
                    CornerRadius="12"
                    BackgroundColor="#27283d"
                    Clicked="OnAddCompanyClicked" />

            <Button Grid.Column="1"
                    Text="⚡ Экспресс-прошивка NFC"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="13"
                    HeightRequest="44"
                    CornerRadius="12"
                    Clicked="OnBatchNfcClicked">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#fd6244" Offset="0.0" />
                        <GradientStop Color="#e73d60" Offset="1.0" />
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
        </Grid>
    </Grid>

</ContentPage>
