<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:net="clr-namespace:MonopolyBank.Networking"
             x:Class="MonopolyBank.Views.JoinGamePage"
             BackgroundColor="#fbfbfd"
             Title="Подключение к игре">

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Margin="22, 16" Spacing="16">

                <!-- 1. Player Name -->
                <Label Text="Ваше имя игрока" 
                       FontAttributes="Bold" 
                       TextColor="#333333" 
                       FontSize="15"/>
                <Border Stroke="#cfd9e5" 
                        StrokeThickness="1" 
                        BackgroundColor="#edf2f7" 
                        StrokeShape="RoundRectangle 12" 
                        HeightRequest="50" 
                        Padding="12,0">
                    <Entry x:Name="Username" 
                           Placeholder="Введите своё имя" 
                           PlaceholderColor="#888888" 
                           TextColor="#111111" 
                           VerticalOptions="Center"/>
                </Border>

                <!-- 2. LAN Discovery Section -->
                <Border Stroke="#0daaa3"
                        StrokeThickness="1"
                        BackgroundColor="#f0fafa"
                        StrokeShape="RoundRectangle 14"
                        Padding="14,12"
                        Margin="0,4,0,4">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="Поиск игр в вашей сети" 
                                   FontAttributes="Bold" 
                                   TextColor="#006666" 
                                   FontSize="15"
                                   VerticalOptions="Center"/>

                            <Button Grid.Column="1"
                                    x:Name="BtnRefreshDiscovery"
                                    Text="Обновить"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="#006666"
                                    BackgroundColor="#d2f2f0"
                                    CornerRadius="8"
                                    HeightRequest="32"
                                    Padding="10,0"
                                    Clicked="OnRefreshDiscoveryClicked" />
                        </Grid>

                        <!-- Scanning Indicator -->
                        <HorizontalStackLayout x:Name="ScanningLayout" Spacing="10" VerticalOptions="Center" IsVisible="True">
                            <ActivityIndicator IsRunning="True" Color="#0daaa3" WidthRequest="22" HeightRequest="22" />
                            <Label Text="Поиск серверов в локальной сети..." TextColor="#555555" FontSize="13" VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <!-- Discovered Servers List -->
                        <CollectionView x:Name="DiscoveredList" 
                                        SelectionMode="None"
                                        HeightRequest="110"
                                        IsVisible="False">
                            <CollectionView.EmptyView>
                                <Label Text="Игры в локальной сети пока не найдены"
                                       TextColor="#777777"
                                       FontSize="13"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Margin="0,15"/>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="net:DiscoveredServer">
                                    <Border Stroke="#b2dfdb"
                                            StrokeThickness="1"
                                            BackgroundColor="White"
                                            StrokeShape="RoundRectangle 10"
                                            Padding="12,8"
                                            Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="{Binding Name}" TextColor="#111111" FontSize="14" FontAttributes="Bold" />
                                                <Label Text="{Binding IpAddress, StringFormat='IP: {0}'}" TextColor="#0daaa3" FontSize="12" />
                                            </VerticalStackLayout>
                                            <Button Grid.Column="1"
                                                    Text="Войти"
                                                    TextColor="White"
                                                    FontAttributes="Bold"
                                                    FontSize="13"
                                                    BackgroundColor="#0daaa3"
                                                    CornerRadius="8"
                                                    HeightRequest="34"
                                                    Padding="14,0"
                                                    Clicked="OnJoinDiscoveredClicked"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- 3. Manual IP Section -->
                <Label Text="Или укажите IP хоста вручную" 
                       FontAttributes="Bold" 
                       TextColor="#555555" 
                       FontSize="14"
                       Margin="0, 4, 0, 0"/>

                <Border Stroke="#cfd9e5" 
                        StrokeThickness="1" 
                        BackgroundColor="#edf2f7" 
                        StrokeShape="RoundRectangle 12" 
                        HeightRequest="50" 
                        Padding="12,0">
                    <Entry x:Name="Ipserver" 
                           Placeholder="Например: 192.168.1.10" 
                           PlaceholderColor="#888888" 
                           TextColor="#111111" 
                           Keyboard="Url"
                           VerticalOptions="Center"/>
                </Border>

                <!-- Checkbox "Режим без NFC" -->
                <Border Stroke="#cfd9e5"
                        StrokeThickness="1"
                        BackgroundColor="#f4f7fa"
                        StrokeShape="RoundRectangle 12"
                        Padding="14,10"
                        Margin="0,4,0,0">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                            <Label Text="Режим без NFC" TextColor="#222" FontSize="14" FontAttributes="Bold" />
                            <Label Text="Выбор карточек и полей вручную на экране" TextColor="#777" FontSize="11" />
                        </VerticalStackLayout>
                        <CheckBox Grid.Column="1" x:Name="NoNfcCheckBox" Color="#8e2de2" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Button x:Name="BtnJoin" 
                        Text="Присоединиться к банку" 
                        Clicked="OnStartJoinGame"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="16"
                        HeightRequest="50"
                        CornerRadius="14"
                        Margin="0, 8, 0, 0">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#019dce" Offset="0.0" />
                            <GradientStop Color="#0daaa3" Offset="1.0" />
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.3" />
                    </Button.Shadow>
                </Button>

            </VerticalStackLayout>
        </ScrollView>

        <Image Grid.Row="1"
               Source="city.png"
               Aspect="AspectFill"
               HeightRequest="150"
               HorizontalOptions="Fill" />
    </Grid>
</ContentPage>
